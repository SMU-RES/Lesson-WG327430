<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeFrameworkVersion>6.0.36</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>汽车综合实践</RootNamespace>
    <AssemblyName>汽车上位机</AssemblyName>
    <Version>5.0.3</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- 界面、协议、数据库和三维代码均属于本工程，无外部源码或兄弟项目引用。 -->
    <Compile Include="源码\**\*.cs" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
  </ItemGroup>
</Project>
